<Window x:Class="Updater.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Updater.GUI"
        mc:Ignorable="d"
        Title="Updater - 程序更新器" Height="500" Width="700"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        MinHeight="400" MinWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12" VerticalAlignment="Center">
            <Image Width="48" Height="48" Margin="0,0,12,0">
                <Image.Source>
                    <DrawingImage>
                        <DrawingImage.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#4A90D9" Geometry="M24,2 L48,24 L24,46 L0,24 Z"/>
                                <GeometryDrawing Brush="White" Geometry="M24,8 L36,20 L24,32 L12,20 Z"/>
                            </DrawingGroup>
                        </DrawingImage.Drawing>
                    </DrawingImage>
                </Image.Source>
            </Image>
            <StackPanel>
                <TextBlock Text="程序更新器" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Updater GUI" FontSize="12" Foreground="#666"/>
            </StackPanel>
        </StackPanel>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 进度条区域 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,5">
                    <TextBlock x:Name="StatusText" Text="准备更新..." FontSize="14" Foreground="#333" />
                    <TextBlock x:Name="ProgressText" Text=" 0%" FontSize="14" Foreground="#4A90D9" FontWeight="Bold" Margin="8,0,0,0"/>
                </StackPanel>
                <ProgressBar x:Name="UpdateProgress" Height="20" IsIndeterminate="True" Background="#E8E8E8" Foreground="#4A90D9"/>
            </StackPanel>

            <!-- 日志区域 -->
            <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="White">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Height="26" Background="#F5F5F5">
                        <StackPanel Orientation="Horizontal" Margin="8,4,8,4">
                            <TextBlock Text="日志" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                            <Separator Width="1" Height="16" Margin="8,2,8,2" Background="#DDD"/>
                            <TextBlock x:Name="LogCountText" Text="0 条" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogTextBox" 
                             IsReadOnly="True"
                             FontFamily="Consolas, 'Courier New', monospace"
                             FontSize="11"
                             Background="White"
                             Foreground="#333"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             Padding="8"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" Width="80" Height="28" Margin="0,0,10,0" Click="CancelButton_Click" IsEnabled="False"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <Button x:Name="CloseButton" Content="关闭" Width="80" Height="28" Click="CloseButton_Click" IsEnabled="False"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
        </StackPanel>
    </Grid>
</Window>